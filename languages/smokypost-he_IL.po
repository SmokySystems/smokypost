msgstr "TLS (בדרך כלל יציאה 587)"

#: includes/Admin/Page.php:438
msgid "SSL (usually port 465)"
msgstr "SSL (בדרך כלל יציאה 465)"

#: includes/Admin/Page.php:439
msgid "No encryption"
msgstr "ללא הצפנה"

#: includes/Admin/Page.php:444
msgid "Username"
msgstr "שם משתמש"

#: includes/Admin/Page.php:448
