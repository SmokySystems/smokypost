msgstr "A plataforma não permitiu a publicação. Verifique se ainda é administrador da página e volte a ligar."

#: includes/Status.php:122
msgid "The platform blocked this post."
msgstr "A plataforma bloqueou esta publicação."

#: includes/Status.php:123
msgid "The platform rejected this post as a duplicate."
msgstr "A plataforma rejeitou esta publicação por ser duplicada."

#: includes/Status.php:124
msgid "Instagram needs an image. Add a featured image."
msgstr "O Instagram precisa de uma imagem. Adicione uma imagem de destaque."

#: includes/Status.php:125
msgid "The platform could not use the image. Try a JPEG or PNG image at least 600 pixels wide."
msgstr "A plataforma não conseguiu usar a imagem. Tente uma imagem JPEG ou PNG com pelo menos 600 píxeis de largura."

#: includes/Status.php:126
msgid "The image could not be read. Use a JPEG, PNG or WebP image."
msgstr "Não foi possível ler a imagem. Use uma imagem JPEG, PNG ou WebP."

#: includes/Status.php:127
msgid "The image is too small. Use an image at least 600 pixels wide."
msgstr "A imagem é demasiado pequena. Use uma imagem com pelo menos 600 píxeis de largura."

#: includes/Status.php:128
msgid "SmokyPost could not download the image from your site."
msgstr "O SmokyPost não conseguiu transferir a imagem do seu site."

#: includes/Status.php:129
msgid "The image could not be prepared."
msgstr "Não foi possível preparar a imagem."

#: includes/Status.php:130
msgid "The platform was not available. SmokyPost tried several times."
msgstr "A plataforma não estava disponível. O SmokyPost tentou várias vezes."

#: includes/Status.php:131
msgid "The platform could not be reached. SmokyPost tried several times."
msgstr "Não foi possível contactar a plataforma. O SmokyPost tentou várias vezes."

#: includes/Status.php:132
msgid "Instagram did not accept the image in time."
msgstr "O Instagram não aceitou a imagem a tempo."

#: includes/Status.php:133
msgid "The platform rejected the post."
msgstr "A plataforma rejeitou a publicação."

#: includes/Status.php:134
msgid "The account that published this post is no longer connected. Delete the post on the platform yourself."
msgstr "A conta que publicou esta publicação já não está ligada. Elimine a publicação você mesmo na plataforma."

#: includes/Status.php:135
msgid "This post cannot be deleted automatically. Delete it on the platform yourself."
msgstr "Esta publicação não pode ser eliminada automaticamente. Elimine-a você mesmo na plataforma."

#. Name of the plugin
#: smokypost.php:3
msgid "SmokyPost – Social Auto Share for Posts and Pages"
msgstr "SmokyPost – Partilha automática nas redes sociais para artigos e páginas"

#. Description of the plugin
#: smokypost.php:5
msgid "Automatically share new and old posts and pages to your social media accounts. No developer accounts or API keys needed."
msgstr "Partilhe automaticamente artigos e páginas novos e antigos nas suas contas de redes sociais. Não são necessárias contas de programador nem chaves de API."
