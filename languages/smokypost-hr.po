msgid "Disconnect this site"
msgstr "Odspoji ovo web-mjesto"

#: includes/Admin/Page.php:574
msgid "Disconnect this site from SmokyPost? Sharing stops until you sign in again."
msgstr "Odspojiti ovo web-mjesto od SmokyPosta? Dijeljenje se zaustavlja dok se ponovno ne prijavite."

#: includes/Admin/Page.php:576
