#: includes/Status.php:114 includes/Status.php:115 includes/Status.php:116
msgid "The connection has expired. Connect again in SmokyPost."
msgstr "Veza je istekla. Ponovno se povežite u SmokyPostu."

#: includes/Status.php:117
msgid "No page or account is selected for this platform."
msgstr "Za ovu platformu nije odabrana stranica ili račun."

#: includes/Status.php:118
msgid "This site is no longer connected to SmokyPost."
msgstr "Ovo web-mjesto više nije povezano sa SmokyPostom."

#: includes/Status.php:119
msgid "Your SmokyPost account or license is not active."
msgstr "Vaš SmokyPost račun ili licenca nije aktivna."

#: includes/Status.php:120
msgid "This platform is not included in your plan."
msgstr "Ova platforma nije uključena u vaš paket."

#: includes/Status.php:121
msgid "The platform did not allow the post. Check that you are still an admin of the page and connect again."
msgstr "Platforma nije dopustila objavu. Provjerite jeste li još uvijek administrator stranice i ponovno se povežite."

#: includes/Status.php:122
msgid "The platform blocked this post."
msgstr "Platforma je blokirala ovu objavu."

#: includes/Status.php:123
msgid "The platform rejected this post as a duplicate."
msgstr "Platforma je odbila ovu objavu kao duplikat."

#: includes/Status.php:124
msgid "Instagram needs an image. Add a featured image."
msgstr "Instagram zahtijeva sliku. Dodajte objavi istaknutu sliku."

#: includes/Status.php:125
msgid "The platform could not use the image. Try a JPEG or PNG image at least 600 pixels wide."
msgstr "Platforma nije mogla upotrijebiti sliku. Isprobajte JPEG ili PNG sliku široku najmanje 600 piksela."

#: includes/Status.php:126
msgid "The image could not be read. Use a JPEG, PNG or WebP image."
msgstr "Sliku nije bilo moguće pročitati. Koristite JPEG, PNG ili WebP."

#: includes/Status.php:127
msgid "The image is too small. Use an image at least 600 pixels wide."
msgstr "Slika je premala. Koristite sliku široku najmanje 600 piksela."

#: includes/Status.php:128
msgid "SmokyPost could not download the image from your site."
msgstr "SmokyPost nije mogao preuzeti sliku s vašeg web-mjesta."

#: includes/Status.php:129
msgid "The image could not be prepared."
msgstr "Sliku nije bilo moguće pripremiti."

#: includes/Status.php:130
msgid "The platform was not available. SmokyPost tried several times."
msgstr "Platforma je bila nedostupna. SmokyPost je pokušao nekoliko puta."

#: includes/Status.php:131
msgid "The platform could not be reached. SmokyPost tried several times."
msgstr "Nije bilo moguće povezati se s platformom. SmokyPost je pokušao nekoliko puta."

#: includes/Status.php:132
msgid "Instagram did not accept the image in time."
msgstr "Instagram nije na vrijeme prihvatio sliku."

#: includes/Status.php:133
msgid "The platform rejected the post."
msgstr "Platforma je odbila objavu."

#: includes/Status.php:134
msgid "The account that published this post is no longer connected. Delete the post on the platform yourself."
msgstr "Račun koji je objavio ovu objavu više nije povezan. Izbrišite objavu sami na platformi."

#: includes/Status.php:135
msgid "This post cannot be deleted automatically. Delete it on the platform yourself."
msgstr "Ova se objava ne može automatski izbrisati. Izbrišite je sami na platformi."

#. Name of the plugin
#: smokypost.php:3
msgid "SmokyPost – Social Auto Share for Posts and Pages"
msgstr "SmokyPost – Automatsko Dijeljenje na Društvenim Mrežama za Objave i Stranice"

#. Description of the plugin
#: smokypost.php:5
msgid "Automatically share new and old posts and pages to your social media accounts. No developer accounts or API keys needed."
msgstr "Automatski dijelite nove i stare objave i stranice na svoje račune na društvenim mrežama. Nisu potrebni razvojni računi ni API ključevi."
