msgstr "SSL (obično port 465)"

#: includes/Admin/Page.php:438
msgid "No encryption"
msgstr "Bez šifriranja"

#: includes/Admin/Page.php:443
msgid "Username"
msgstr "Korisničko ime"

#: includes/Admin/Page.php:447
msgid "The password is set in wp-config.php."
msgstr "Lozinka je postavljena u datoteci wp-config.php."

#: includes/Admin/Page.php:451
msgid "A password is saved. Leave this empty to keep it."
msgstr "Lozinka je spremljena. Ostavite prazno da je zadržite."

#: includes/Admin/Page.php:451
msgid "Remove the saved password"
msgstr "Ukloni spremljenu lozinku"

#: includes/Admin/Page.php:453
msgid "The password is stored encrypted and never shown again. For Gmail and Outlook use an app password."
msgstr "Lozinka se sprema šifrirana i više se nikada ne prikazuje. Za Gmail i Outlook koristite lozinku za aplikaciju."

#: includes/Admin/Page.php:457
msgid "From e-mail"
msgstr "E-pošta pošiljatelja"

#: includes/Admin/Page.php:458
msgid "Most providers only accept an address that belongs to the account."
msgstr "Većina pružatelja prihvaća samo adresu koja pripada računu."

#: includes/Admin/Page.php:459
msgid "From name"
msgstr "Ime pošiljatelja"

#: includes/Admin/Page.php:462
msgid "Save Changes"
msgstr "Spremi promjene"

#: includes/Admin/Page.php:463
msgid "Send a test e-mail"
msgstr "Pošalji probnu e-poštu"

#: includes/Admin/Page.php:464
msgid "The test e-mail saves the values above first and then uses them."
msgstr "Probna e-pošta prvo sprema gornje vrijednosti, a zatim ih koristi."

