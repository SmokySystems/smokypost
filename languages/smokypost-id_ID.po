msgstr "Koneksi telah kedaluwarsa. Hubungkan ulang di SmokyPost."

#: includes/Status.php:117
msgid "No page or account is selected for this platform."
msgstr "Tidak ada halaman atau akun yang dipilih untuk platform ini."

#: includes/Status.php:118
msgid "This site is no longer connected to SmokyPost."
msgstr "Situs ini tidak lagi terhubung ke SmokyPost."

#: includes/Status.php:119
msgid "Your SmokyPost account or license is not active."
msgstr "Akun atau lisensi SmokyPost Anda tidak aktif."

#: includes/Status.php:120
msgid "This platform is not included in your plan."
msgstr "Platform ini tidak termasuk dalam paket Anda."

#: includes/Status.php:121
msgid "The platform did not allow the post. Check that you are still an admin of the page and connect again."
msgstr "Platform tidak mengizinkan posting. Pastikan Anda masih admin halaman tersebut dan hubungkan ulang."

#: includes/Status.php:122
msgid "The platform blocked this post."
msgstr "Platform memblokir postingan ini."

#: includes/Status.php:123
msgid "The platform rejected this post as a duplicate."
msgstr "Platform menolak postingan ini sebagai duplikat."

#: includes/Status.php:124
msgid "Instagram needs an image. Add a featured image."
msgstr "Instagram memerlukan gambar. Tambahkan gambar unggulan ke tulisan."

#: includes/Status.php:125
msgid "The platform could not use the image. Try a JPEG or PNG image at least 600 pixels wide."
msgstr "Platform tidak dapat menggunakan gambar. Coba gambar JPEG atau PNG dengan lebar minimal 600 piksel."

#: includes/Status.php:126
msgid "The image could not be read. Use a JPEG, PNG or WebP image."
msgstr "Gambar tidak dapat dibaca. Gunakan JPEG, PNG, atau WebP."

#: includes/Status.php:127
msgid "The image is too small. Use an image at least 600 pixels wide."
msgstr "Gambar terlalu kecil. Gunakan gambar dengan lebar minimal 600 piksel."

#: includes/Status.php:128
msgid "SmokyPost could not download the image from your site."
msgstr "SmokyPost tidak dapat mengunduh gambar dari situs Anda."

#: includes/Status.php:129
msgid "The image could not be prepared."
msgstr "Gambar tidak dapat disiapkan."

#: includes/Status.php:130
msgid "The platform was not available. SmokyPost tried several times."
msgstr "Platform tidak tersedia. SmokyPost sudah mencoba beberapa kali."

#: includes/Status.php:131
msgid "The platform could not be reached. SmokyPost tried several times."
msgstr "Tidak dapat terhubung ke platform. SmokyPost sudah mencoba beberapa kali."

#: includes/Status.php:132
msgid "Instagram did not accept the image in time."
msgstr "Instagram tidak menerima gambar tepat waktu."

#: includes/Status.php:133
msgid "The platform rejected the post."
msgstr "Platform menolak postingan."

#: includes/Status.php:134
msgid "The account that published this post is no longer connected. Delete the post on the platform yourself."
msgstr "Akun yang memposting ini tidak lagi terhubung. Hapus postingan sendiri di platform."

#: includes/Status.php:135
msgid "This post cannot be deleted automatically. Delete it on the platform yourself."
msgstr "Postingan ini tidak dapat dihapus otomatis. Hapus sendiri di platform."

#. Name of the plugin
#: smokypost.php:3
msgid "SmokyPost – Social Auto Share"
msgstr "SmokyPost – Berbagi Otomatis ke Media Sosial"

#. Description of the plugin
#: smokypost.php:5
msgid "Automatically share new and old posts and pages to your social media accounts. No developer accounts or API keys needed."
msgstr "Bagikan pos dan halaman baru maupun lama secara otomatis ke akun media sosial Anda. Tidak perlu akun pengembang atau kunci API."
