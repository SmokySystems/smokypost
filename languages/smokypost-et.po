#. Name of the plugin
#: smokypost.php:3
msgid "SmokyPost – Social Auto Share for Posts and Pages"
msgstr "SmokyPost – Automaatne Jagamine Sotsiaalmeedias Postituste ja Lehtede Jaoks"

