msgstr "A jelszót titkosítva tároljuk, és soha többé nem jelenítjük meg. Gmailhez és Outlookhoz alkalmazásjelszót használjon."

#: includes/Admin/Page.php:457
msgid "From e-mail"
msgstr "Feladó e-mail-címe"

#: includes/Admin/Page.php:458
msgid "Most providers only accept an address that belongs to the account."
msgstr "A legtöbb szolgáltató csak a fiókhoz tartozó címet fogadja el."

#: includes/Admin/Page.php:459
