#: includes/Admin/Page.php:377
msgid "Content types"
msgstr "Tartalomtípusok"

#: includes/Admin/Page.php:381
msgid "Only these types are shared automatically and get the SmokyPost box in the editor."
msgstr "Csak ezek a típusok kerülnek automatikusan megosztásra, és csak ezeknél jelenik meg a SmokyPost-doboz a szerkesztőben."

#: includes/Admin/Page.php:383
msgid "Automatic sharing"
msgstr "Automatikus megosztás"

#: includes/Admin/Page.php:384
msgid "Share new items automatically when they are published to:"
msgstr "Az új tartalmak automatikus megosztása közzétételkor ide:"

#: includes/Admin/Page.php:386
