msgstr "Chỉ các loại này được tự động chia sẻ, và chỉ các loại này hiển thị hộp SmokyPost trong trình soạn thảo."

#: includes/Admin/Page.php:383
msgid "Automatic sharing"
msgstr "Tự động chia sẻ"

#: includes/Admin/Page.php:384
