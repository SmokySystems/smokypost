#. Name of the plugin
#: smokypost.php:3
msgid "SmokyPost – Social Auto Share for Posts and Pages"
msgstr "SmokyPost – Compartició Automàtica a les Xarxes Socials per a Entrades i Pàgines"

#. Description of the plugin
#: smokypost.php:5
msgid "Automatically share new and old posts and pages to your social media accounts. No developer accounts or API keys needed."
msgstr "Comparteix automàticament entrades i pàgines noves i antigues als teus comptes de xarxes socials. No calen comptes de desenvolupador ni claus d'API."
