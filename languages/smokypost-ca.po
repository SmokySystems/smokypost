msgstr "SmokyPost Pro %s està instal·lat i actiu."

#: includes/Admin/Page.php:623
msgid "Its settings are under SmokyPost > Pro, the calendar under SmokyPost > Calendar. It updates itself."
msgstr "La seva configuració és a SmokyPost > Pro i el calendari a SmokyPost > Calendari. S'actualitza sol."

#: includes/Admin/Page.php:630
msgid "SmokyPost Pro is installed but not active. Activate it on the Plugins page."
msgstr "SmokyPost Pro està instal·lat però no actiu. Activa'l a la pàgina Connectors."

#: includes/Admin/Page.php:630
msgid "Open Plugins"
msgstr "Obre Connectors"

#: includes/Admin/Page.php:635
msgid "Download SmokyPost Pro"
msgstr "Descarrega SmokyPost Pro"

