msgstr "Pošlji preizkusno e-pošto"

#: includes/Admin/Page.php:464
msgid "The test e-mail saves the values above first and then uses them."
msgstr "Preizkusna e-pošta najprej shrani zgornje vrednosti, nato jih uporabi."

