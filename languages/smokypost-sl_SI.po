msgstr "Prekini povezavo tega spletnega mesta"

#: includes/Admin/Page.php:574
msgid "Disconnect this site from SmokyPost? Sharing stops until you sign in again."
msgstr "Želite prekiniti povezavo tega spletnega mesta s storitvijo SmokyPost? Deljenje se ustavi, dokler se ne prijavite znova."

#: includes/Admin/Page.php:576
