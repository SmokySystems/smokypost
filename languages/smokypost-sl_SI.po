#: includes/Status.php:135
msgid "This post cannot be deleted automatically. Delete it on the platform yourself."
msgstr "Te objave ni mogoče samodejno izbrisati. Izbrišite jo sami na platformi."

#. Name of the plugin
#: smokypost.php:3
msgid "SmokyPost – Social Auto Share for Posts and Pages"
msgstr "SmokyPost – Samodejno deljenje na družbenih omrežjih za objave in strani"

#. Description of the plugin
#: smokypost.php:5
msgid "Automatically share new and old posts and pages to your social media accounts. No developer accounts or API keys needed."
msgstr "Samodejno delite nove in stare objave ter strani na svojih računih na družbenih omrežjih. Razvijalskih računov ali ključev API ni treba."
