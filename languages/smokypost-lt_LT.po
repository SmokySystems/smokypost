#. Name of the plugin
#: smokypost.php:3
msgid "SmokyPost – Social Auto Share"
msgstr "SmokyPost – Automatinis Dalijimasis Socialiniuose Tinkluose"

#. Description of the plugin
#: smokypost.php:5
msgid "Automatically share new and old posts and pages to your social media accounts. No developer accounts or API keys needed."
msgstr "Automatiškai dalinkitės naujais ir senais įrašais bei puslapiais savo socialinių tinklų paskyrose. Kūrėjo paskyrų ar API raktų nereikia."
