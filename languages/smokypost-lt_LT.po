msgstr "Ryšys nebegalioja. Prisijunkite iš naujo, kad galėtumėte toliau bendrinti."

#: includes/Admin/Page.php:239
msgid "Connect again"
msgstr "Prijungti iš naujo"

#: includes/Admin/Page.php:242
