msgstr "Instagram görseli zamanında kabul etmedi."

#: includes/Status.php:133
msgid "The platform rejected the post."
msgstr "Platform paylaşımı reddetti."

#: includes/Status.php:134
msgid "The account that published this post is no longer connected. Delete the post on the platform yourself."
msgstr "Bu gönderiyi yayımlayan hesabın bağlantısı artık yok. Gönderiyi platformdan kendiniz silin."

#: includes/Status.php:135
msgid "This post cannot be deleted automatically. Delete it on the platform yourself."
msgstr "Bu gönderi otomatik silinemiyor. Platformdan kendiniz silin."

#. Name of the plugin
#: smokypost.php:3
msgid "SmokyPost – Social Auto Share for Posts and Pages"
msgstr "SmokyPost – Yazılar ve Sayfalar için Otomatik Sosyal Medya Paylaşımı"

#. Description of the plugin
#: smokypost.php:5
msgid "Automatically share new and old posts and pages to your social media accounts. No developer accounts or API keys needed."
msgstr "Yeni ve eski yazı ve sayfalarınızı sosyal medya hesaplarınızda otomatik olarak paylaşın. Geliştirici hesabı veya API anahtarı gerekmez."
