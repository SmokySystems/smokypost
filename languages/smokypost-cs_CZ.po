msgid "Content types"
msgstr "Typy obsahu"

#: includes/Admin/Page.php:381
msgid "Only these types are shared automatically and get the SmokyPost box in the editor."
msgstr "Automaticky se sdílejí jen tyto typy a jen ony mají v editoru pole SmokyPost."

#: includes/Admin/Page.php:383
msgid "Automatic sharing"
msgstr "Automatické sdílení"

