msgstr "Publikuje Twój tekst i link na jednej z Twoich stron na Facebooku. Logujesz się przez Facebooka."

#: includes/Admin/Page.php:279
msgid "Needs an Instagram professional account linked to a Facebook Page. You sign in with Facebook."
msgstr "Wymaga konta profesjonalnego na Instagramie połączonego ze stroną na Facebooku. Logujesz się przez Facebooka."

#: includes/Admin/Page.php:281
msgid "Posts your text and a link to one of your LinkedIn company pages. You sign in with LinkedIn."
msgstr "Publikuje Twój tekst i link na jednej z Twoich stron firmowych w LinkedIn. Logujesz się przez LinkedIn."

#: includes/Admin/Page.php:283
msgid "Posts your text, hashtags and a link card with the picture to your Bluesky account. You connect with your handle and an app password."
msgstr "Publikuje Twój tekst, hashtagi i kartę linku z obrazem na Twoim koncie Bluesky. Łączysz się za pomocą nazwy użytkownika i hasła aplikacji."

#: includes/Admin/Page.php:285
msgid "Posts your text, hashtags and a link to your Mastodon account on any Mastodon server. You approve SmokyPost on your own server."
msgstr "Publikuje Twój tekst, hashtagi i link na Twoim koncie Mastodon na dowolnym serwerze Mastodon. Zatwierdzasz SmokyPost na własnym serwerze."

#: includes/Admin/Page.php:287
msgid "Posts your text and a link card to your Threads profile. You sign in with Threads."
msgstr "Publikuje Twój tekst i kartę linku na Twoim profilu w Threads. Logujesz się przez Threads."

