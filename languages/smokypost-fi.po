#. Name of the plugin
#: smokypost.php:3
msgid "SmokyPost – Social Auto Share"
msgstr "SmokyPost – Automaattinen Jakaminen Sosiaaliseen Mediaan"

#. Description of the plugin
#: smokypost.php:5
msgid "Automatically share new and old posts and pages to your social media accounts. No developer accounts or API keys needed."
msgstr "Jaa uudet ja vanhat julkaisut ja sivut automaattisesti sosiaalisen median tileillesi. Kehittäjätilejä tai API-avaimia ei tarvita."
